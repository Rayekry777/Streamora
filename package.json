{
  "name": "streamora",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev:web": "pnpm --filter @streamora/web dev",
    "dev:admin": "pnpm --filter @streamora/admin-web dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "contract:lint": "redocly lint packages/openapi/streamora-v1.yaml",
    "contract:generate": "openapi-typescript packages/openapi/streamora-v1.yaml -o packages/openapi/generated/streamora-v1.d.ts",
    "commitlint": "commitlint --config commitlint.config.mjs",
    "git:metadata": "node scripts/ci/validate-git-metadata.mjs",
    "test:governance": "node --test scripts/ci/tests/*.test.mjs scripts/loop/tests/*.test.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/lint": "21.2.2",
    "@playwright/test": "1.62.0",
    "@redocly/cli": "^2.46.1",
    "openapi-typescript": "^7.13.0"
  }
}
