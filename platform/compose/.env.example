# 复制为 platform/compose/.env 后再启动。所有值仅用于本地封闭演示，请自行更换。
STREAMORA_IMAGE_TAG=dev
POSTGRES_PASSWORD=replace-with-local-postgres-password
STREAMORA_SERVICE_DB_PASSWORD=replace-with-local-service-password
MINIO_ROOT_USER=streamora-local-admin
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
GRAFANA_ADMIN_USER=streamora-local-admin
GRAFANA_ADMIN_PASSWORD=replace-with-local-grafana-password

# 仅绑定到本机回环地址，避免开发组件暴露到局域网。
WEB_PORT=3000
ADMIN_WEB_PORT=3001
NACOS_PORT=8848
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# 单个 Java 运行单元的默认内存上限；full 环境需要约 20GB 总内存。
BACKEND_MEMORY_LIMIT=768m

