# 复制为 platform/compose/.env 后再启动。以下弱凭据仅用于本地封闭演示，绝不能用于公网。
STREAMORA_IMAGE_TAG=dev
POSTGRES_PASSWORD=123456
STREAMORA_SERVICE_DB_PASSWORD=123456
STREAMORA_BOOTSTRAP_ADMIN_LOGIN=admin
STREAMORA_BOOTSTRAP_ADMIN_PASSWORD=123456
STREAMORA_BOOTSTRAP_ADMIN_DISPLAY_NAME=admin
# 封闭演示仅通过虚拟机回环地址和 SSH 隧道访问 HTTP，因此 Cookie 不标记 Secure。
# 接入 TLS 反向代理后改为 true。
STREAMORA_SECURE_COOKIE=false
# 新数据库中 bootstrap 管理员会由 identity-service 在用户请求前创建，默认 subjectId 为 1。
STREAMORA_BOOTSTRAP_ADMIN_SUBJECT_ID=1
# Nacos 3 要求至少 32 位原文进行 Base64 编码后的令牌；生产环境请在本机 .env 中替换。
NACOS_AUTH_TOKEN=U3RyZWFtb3JhQ2xvc2VkRGVtb05hY29zVG9rZW5Gb3JMb2NhbE9ubHkyMDI2
MINIO_ROOT_USER=admin
# MinIO 要求密码至少 8 位，不能使用 123456。
MINIO_ROOT_PASSWORD=admin123
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=123456

# 仅绑定到本机回环地址，避免开发组件暴露到局域网。
WEB_PORT=3000
ADMIN_WEB_PORT=3001
NACOS_PORT=8848
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# 单个 Java 运行单元的默认内存上限；full 环境需要约 20GB 总内存。
BACKEND_MEMORY_LIMIT=768m
