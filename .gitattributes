* text=auto

# Linux 容器和 Maven Wrapper 脚本必须保持 LF，避免 Windows 检出后无法执行。
*.sh text eol=lf
mvnw text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows 入口脚本保持原生换行。
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制资源不参与换行转换。
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
*.jar binary

